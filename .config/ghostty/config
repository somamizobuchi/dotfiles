window-position-x=-1
window-position-y=-1
window-width=80
window-height=24
theme = Kanagawa Wave
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
cursor-opacity = 0.5
background-blur-radius = 20
background-opacity = 0.9
font-size = 16
unfocused-split-opacity = 0.4

## Keybinds ##
keybind = cmd+r=reload_config
# Vim like split navigations
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
